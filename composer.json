{
  "name": "amine-zhioua/degache-php",
  "description": "A framework-agnostic PHP library of Tunisian utilities: phone number, CIN, RIB, car plate, postal code, and tax ID validation, plus currency and date formatting for the Tunisian locale.",
  "type": "library",
  "require-dev": {
    "phpunit/phpunit": "11"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AmineZhioua\\DegachePhp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AmineZhioua\\DegachePhp\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Amine Zhioua"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-intl": "*"
  },
  "keywords": [
    "tunisia",
    "tunisian",
    "validation",
    "rib",
    "iban",
    "cin",
    "phone-number",
    "car-plate",
    "postal-code",
    "tax-id",
    "matricule-fiscal",
    "currency",
    "formatter"
  ],
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
